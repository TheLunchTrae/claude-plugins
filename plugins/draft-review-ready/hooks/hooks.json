{
  "description": "Draft-Review-Ready PR Workflow: track PRs this session opens and block ending a turn while their review loop is unfinished",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__.*__(create_pull_request|update_pull_request|merge_pull_request)",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pr-workflow.mjs\" post-tool-use", "timeout": 10 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pr-workflow.mjs\" post-tool-use-failure", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pr-workflow.mjs\" user-prompt-submit", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pr-workflow.mjs\" stop", "timeout": 10 }
        ]
      }
    ]
  }
}
